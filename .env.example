# ---------------------------------------------------------------------------
# The Last Lap - standalone PostgreSQL: local configuration template
#
#   1. cp .env.example .env
#   2. Replace EVERY "replace_with_..." value with a strong, unique password.
#      Tip: openssl rand -hex 24   (hex avoids quoting problems in shells/URLs)
#   3. Never commit .env. Never put these values into the frontend.
#
# Scripts refuse to run while a password still starts with "replace_with_".
# ---------------------------------------------------------------------------

# Docker image (major version is pinned on purpose; see README "PostgreSQL version")
POSTGRES_IMAGE=postgres:17

# Dedicated database for this project (NOT the old SQLite file, NOT any other DB)
POSTGRES_DB=last_lap_db

# Where clients on the HOST machine reach PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# 127.0.0.1 = only this machine can connect. Do not change to 0.0.0.0 without a firewall.
POSTGRES_BIND_ADDRESS=127.0.0.1

# Bootstrap superuser. Used ONLY to create roles/databases. Never give it to an application.
POSTGRES_SUPERUSER=last_lap_admin
POSTGRES_SUPERUSER_PASSWORD=replace_with_a_secure_password

# Owner of all tables. Used ONLY to run migrations, backups and restores (DDL rights).
LAST_LAP_MIGRATOR_USER=last_lap_migrator
LAST_LAP_MIGRATOR_PASSWORD=replace_with_a_secure_password

# Runtime role for the future backend: data access only, no DDL, no superuser.
LAST_LAP_APP_USER=last_lap_user
LAST_LAP_APP_PASSWORD=replace_with_a_secure_password
